l---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const latest = posts[0];
const rest = posts.slice(1);

function readingTime(body: string) {
  const words = body?.split(/\s+/).length ?? 0;
  return Math.max(1, Math.round(words / 200));
}
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>

      {latest && (
        <section class="hero">
          {latest.data.tags?.[0] && (
            <div class="tag">{latest.data.tags[0]}</div>
          )}
          <a href={`/blog/${latest.id}/`} class="hero-title-link">
            <h1 class="hero-title">{latest.data.title}</h1>
          </a>
          <div class="meta">
            Andrew Dobrow &nbsp;·&nbsp;
            {latest.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            &nbsp;·&nbsp; {readingTime(latest.body)} min read
          </div>
          {latest.data.description && (
            <p class="excerpt">{latest.data.description}</p>
          )}
        </section>
      )}

      <hr />

      {rest.length > 0 && (
        <>
          <div class="section-label">All posts</div>
          <div class="post-list">
            {rest.map((post) => {
              const d = post.data.pubDate;
              const day = d.getDate();
              const mon = d.toLocaleDateString('en-US', { month: 'short' });
              return (
                <a href={`/blog/${post.id}/`} class="post-item">
                  <div class="post-text">
                    {post.data.tags?.[0] && (
                      <div class="tag">{post.data.tags[0]}</div>
                    )}
                    <div class="post-title">{post.data.title}</div>
                    <div class="meta">{mon} {day} &nbsp;·&nbsp; {readingTime(post.body)} min read</div>
                  </div>
                  <div class="date-block">
                    <div class="date-day">{day}</div>
                    <div class="date-mon">{mon}</div>
                  </div>
                </a>
              );
            })}
          </div>
        </>
      )}

    </main>
    <Footer />
  </body>
</html>

<style>
  .hero { margin-bottom: 2.5rem; }

  .tag {
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #999;
    margin-bottom: 0.5rem;
  }

  .hero-title-link { text-decoration: none; }

  .hero-title {
    font-size: 26px;
    line-height: 1.35;
    letter-spacing: -0.4px;
    margin-bottom: 0.6rem;
  }

  .meta {
    font-family: Arial, sans-serif;
    font-size: 13px;
    color: #999;
  }

  .excerpt {
    font-size: 17px;
    color: #555;
    margin-top: 0.75rem;
    margin-bottom: 0;
  }

  .section-label {
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #999;
    margin-bottom: 1.5rem;
  }

  .post-list { display: flex; flex-direction: column; gap: 1.75rem; }

  .post-item {
    display: grid;
    grid-template-columns: 1fr 56px;
    gap: 1rem;
    align-items: start;
    text-decoration: none;
    color: inherit;
  }
  .post-item:hover .post-title { opacity: 0.6; }

  .post-title {
    font-family: Georgia, serif;
    font-size: 17px;
    line-height: 1.4;
    letter-spacing: -0.2px;
    color: #1a1a1a;
    margin-bottom: 0.3rem;
    transition: opacity 0.15s;
  }

  .date-block { text-align: right; font-family: Arial, sans-serif; }
  .date-day { font-size: 20px; font-weight: 500; color: #1a1a1a; line-height: 1; }
  .date-mon { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: #999; margin-top: 2px; }
</style>