---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Webmentions from '../../components/Webmentions.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const permalink = new URL(Astro.url.pathname, Astro.site).href;
const formatDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={`${post.data.title} — Andrew Dobrow`} description={post.data.description} type="article" image={post.data.heroImage} /></head>
  <body>
    <Header />
    <main>
      <article class="h-entry">
        <header class="post-header">
          <a class="back" href="/blog/"><span aria-hidden="true">←</span> All writing</a>
          {post.data.tags?.[0] && <span class="eyebrow">{post.data.tags[0]}</span>}
          <h1 class="p-name">{post.data.title}</h1>
          <div class="byline">
            <span class="p-author h-card"><a class="p-name u-url" href="/">Andrew Dobrow</a></span>
            <span aria-hidden="true">·</span>
            <time class="dt-published" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            {post.data.updatedDate && <><span aria-hidden="true">·</span><span>Updated {formatDate(post.data.updatedDate)}</span></>}
          </div>
          <a href={permalink} class="u-url sr-only" aria-label="Permanent link to this article">Permalink</a>
        </header>
        <div class="prose e-content"><Content /></div>
      </article>
      <nav class="after-post" aria-label="Post navigation"><a href="/blog/">← Back to all posts</a><a href="/rss.xml">Subscribe via RSS ↗</a></nav>
      <Webmentions target={permalink} />
    </main>
    <Footer />
  </body>
</html>
<style>
.post-header { margin-bottom: 42px; }
.back { font-size: .86rem; display: block; width: fit-content; color: var(--muted); text-decoration: none; margin-bottom: 38px; }
.back:hover { color: var(--accent); }
.post-header .eyebrow { margin-bottom: 14px; }
.post-header h1 { font-size: clamp(2.15rem, 6vw, 3.05rem); max-width: 720px; margin: 0 0 19px; }
.byline { color: var(--muted); display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: .82rem; }
.byline a { color: inherit; text-decoration: none; }
.byline a:hover { color: var(--accent); }
.after-post { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-top: 43px; border-top: 1px solid var(--line); padding-top: 23px; font-size: .85rem; }
.after-post a { text-decoration: none; }
</style>
