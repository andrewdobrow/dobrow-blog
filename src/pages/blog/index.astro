---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={`Blog — ${SITE_TITLE}`} description="All the essays, updates, and occasional thoughts by Andrew Dobrow" /></head>
  <body>
    <Header />
    <main>
      <header class="page-heading">
        <div class="eyebrow">The archive</div>
        <h1>Blog</h1>
        <p>Writing about building things, independent publishing, work, and life. Sometimes thoughtfully. Sometimes just to get it out of my head.</p>
      </header>
      <PostList posts={posts} />
      {posts.length === 0 && <p>No posts just yet.</p>}
      <p class="feed-invite">Want to keep up? <a href="/rss.xml">Subscribe to the RSS feed ↗</a></p>
    </main>
    <Footer />
  </body>
</html>
<style>
.feed-invite { font-size: .88rem; color: var(--muted); margin-top: 33px; }
</style>
