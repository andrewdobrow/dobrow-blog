---
import type { HTMLAttributes } from 'astro/types';
type Props = HTMLAttributes<'a'>;
const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const target = String(href).replace(/\/+$/, '') || '/';
const isActive = target !== '/' && (pathname === target || pathname.startsWith(target + '/'));
---
<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}><slot /></a>
<style>
a { color: var(--muted); font-size: .9rem; font-weight: 550; text-decoration: none; transition: color .15s ease; }
a:hover, a.active { color: var(--ink); }
a.active { font-weight: 730; }
</style>
