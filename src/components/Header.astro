---
import HeaderLink from './HeaderLink.astro';
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="wordmark" aria-label="Andrew Dobrow — home">Andrew Dobrow</a>
    <nav aria-label="Main navigation">
      <HeaderLink href="/about/">About</HeaderLink>
      <HeaderLink href="/blog/">Blog</HeaderLink>
      <HeaderLink href="/now/">Now</HeaderLink>
    </nav>
  </div>
</header>
<style>
.site-header { border-bottom: 1px solid var(--line); }
.header-inner { width: min(calc(100% - 44px), var(--width)); margin: auto; min-height: 79px; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; }
.wordmark { font-size: 1.04rem; font-weight: 760; letter-spacing: -.035em; color: var(--ink); text-decoration: none; white-space: nowrap; }
nav { display: flex; flex-wrap: wrap; align-items: center; gap: clamp(14px, 4vw, 29px); }
@media (max-width: 600px) { .header-inner { width: min(calc(100% - 36px), var(--width)); min-height: 70px; } nav { gap: 14px; } }
</style>
