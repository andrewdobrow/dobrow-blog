---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE, AVATAR_PATH, WEBMENTION_ENDPOINT } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
}
const { title, description, image, type = 'website' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image?.src ?? AVATAR_PATH, Astro.site);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#fcfcfb" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" />
<link rel="canonical" href={canonicalURL.href} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} — RSS`} href={new URL('/rss.xml', Astro.site).href} />
<!-- Activate the domain at webmention.io after deploying; see WEBMENTIONS_SETUP.md. -->
<link rel="webmention" href={WEBMENTION_ENDPOINT} />
<link rel="pingback" href="https://webmention.io/dobrow.blog/xmlrpc" />
<!-- IndieWeb identity: GitHub profile should link back to https://dobrow.blog. -->
<link rel="me" href="https://github.com/andrewdobrow" />
<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage.href} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage.href} />
