
---
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <a class="rss-link" href="/rss.xml">
      RSS <span aria-hidden="true">↗</span>
    </a>

    <div class="webring">
      <a href="https://xn--sr8hvo.ws/previous">←</a>
      <a href="https://xn--sr8hvo.ws">An IndieWeb Webring</a>
      <span>🕸💍</span>
      <a href="https://xn--sr8hvo.ws/next">→</a>
    </div>

    <div class="copyright">© {year} Andrew Dobrow</div>
  </div>
</footer>

<style>
.site-footer {
  border-top: 1px solid var(--line);
}

.footer-inner {
  width: min(calc(100% - 44px), var(--width));
  margin: 0 auto;
  padding: 25px 0 35px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 16px;
}

.rss-link {
  justify-self: start;
}

.webring {
  grid-column: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  white-space: nowrap;
}

.rss-link,
.webring a {
  font-size: .82rem;
  color: var(--muted);
  text-decoration: none;
}

.rss-link:hover,
.webring a:hover {
  color: var(--accent);
}

.copyright {
  justify-self: end;
  font-size: .76rem;
  color: var(--muted);
  white-space: nowrap;
}

@media (max-width: 600px) {
  .footer-inner {
    width: min(calc(100% - 36px), var(--width));
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 12px;
  }

  .rss-link,
  .webring,
  .copyright {
    grid-column: 1;
    justify-self: center;
  }

  .webring {
    flex-wrap: wrap;
    white-space: normal;
  }
}
</style>

