---
const today = new Date();
---
<footer>
  <div class="footer-inner">
    <span>&copy; {today.getFullYear()} Andrew Dobrow</span>
  </div>
</footer>

<style>
  footer {
    border-top: 0.5px solid #e0e0e0;
    margin-top: 4rem;
  }
  .footer-inner {
    max-width: 640px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem;
    font-family: Arial, sans-serif;
    font-size: 13px;
    color: #999;
  }
</style>