<style>
.site-footer { border-top: 1px solid var(--line); }
.footer-inner { width: min(calc(100% - 44px), var(--width)); margin: auto; padding: 25px 0 35px; display: flex; justify-content: space-between; gap: 16px 30px; align-items: center; flex-wrap: wrap; }
.footer-links { display: flex; gap: 19px; align-items: center; flex-wrap: wrap; }
.footer-links a { font-size: .82rem; color: var(--muted); text-decoration: none; }
.footer-links a:hover { color: var(--accent); }
.copyright { font-size: .76rem; color: var(--muted); }
@media (max-width: 600px) { .footer-inner { width: min(calc(100% - 36px), var(--width)); flex-direction: column; align-items: flex-start; } }
</style>
